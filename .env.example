# --- Required ---
# Atlas Sandbox connection string (see README / hackathon email). Database name: agentshield
# Either set MONGODB_URI in full, or leave it empty and set MONGODB_HOST + USER + PASSWORD
MONGODB_URI=
# Cluster host from Connect > Drivers, e.g. cluster0.abcde.mongodb.net
MONGODB_HOST=
MONGODB_USER=
MONGODB_PASSWORD=
# OpenAI API key (used by agentshield/llm.py)
LLM_API_KEY=
# Voyage AI key for embeddings
VOYAGE_API_KEY=

# --- Models ---
LLM_MODEL_REASONING=gpt-5.6-luna
LLM_MODEL_FAST=gpt-5.6-luna
VOYAGE_MODEL=voyage-4-large
EMBEDDING_DIM=1024

# --- Behavior ---
MONGODB_DB=agentshield
FP_THRESHOLD=0.01
AGENT_ENGINE_ENABLED=false

# Voyage endpoint: MongoDB Model API keys use ai.mongodb.com; voyageai.com keys use api.voyageai.com
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
